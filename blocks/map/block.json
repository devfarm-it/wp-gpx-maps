{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-gpx-maps/map",
	"title": "GPX Map",
	"category": "embed",
	"icon": "location-alt",
	"description": "Show a GPX track on a map with elevation, speed and heart rate charts.",
	"keywords": [ "gpx", "map", "track", "elevation", "gps" ],
	"textdomain": "wp-gpx-maps",
	"attributes": {
		"gpx": { "type": "string", "default": "" },
		"mtype": { "type": "string" },
		"mheight": { "type": "string" },
		"gheight": { "type": "string" },
		"mlinecolor": { "type": "string" },
		"colorby": { "type": "string" },
		"mapboxstyle": { "type": "string" },
		"mapbox3d": { "type": "boolean" },
		"pitch": { "type": "string" },
		"bearing": { "type": "string" },
		"kmmarkers": { "type": "string" },
		"startend": { "type": "boolean" },
		"fadeedges": { "type": "boolean" },
		"glinecolor": { "type": "string" },
		"uom": { "type": "string" },
		"uomspeed": { "type": "string" },
		"showele": { "type": "boolean" },
		"showspeed": { "type": "boolean" },
		"showhr": { "type": "boolean" },
		"showcad": { "type": "boolean" },
		"showatemp": { "type": "boolean" },
		"showgrade": { "type": "boolean" },
		"waypoints": { "type": "boolean" },
		"download": { "type": "boolean" },
		"zoomonscrollwheel": { "type": "boolean" },
		"summary": { "type": "boolean" },
		"summarytotlen": { "type": "boolean" },
		"summarymaxele": { "type": "boolean" },
		"summaryminele": { "type": "boolean" },
		"summaryeleup": { "type": "boolean" },
		"summaryeledown": { "type": "boolean" },
		"summaryavgspeed": { "type": "boolean" },
		"summarytotaltime": { "type": "boolean" },
		"summarymovingtime": { "type": "boolean" },
		"summarymaxspeed": { "type": "boolean" },
		"summarymaxgrade": { "type": "boolean" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"style": "output-style"
}
